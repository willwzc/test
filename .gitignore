# Extensionless programs compiled beside source files.
# Keep directories, files with extensions, and standard build/documentation files.
/cnotes/**
!/cnotes/**/
!/cnotes/**/*.*
!/cnotes/**/Makefile
!/cnotes/**/makefile
!/cnotes/**/GNUmakefile
!/cnotes/**/README
!/cnotes/**/LICENSE
!/cnotes/**/COPYING
!/cnotes/**/NOTICE
!/cnotes/**/CHANGELOG

/exercisesInC/**
!/exercisesInC/**/
!/exercisesInC/**/*.*
!/exercisesInC/**/Makefile
!/exercisesInC/**/makefile
!/exercisesInC/**/GNUmakefile
!/exercisesInC/**/README
!/exercisesInC/**/LICENSE
!/exercisesInC/**/COPYING
!/exercisesInC/**/NOTICE
!/exercisesInC/**/CHANGELOG

# Generated build directories
/build/
/bin/

# Compiler, linker, and coverage outputs
*.o
*.obj
*.exe
*.out
*.a
*.so
*.so.*
*.dll
*.dylib
*.pdb
*.ilk
*.gcda
*.gcno
*.gcov
*.dSYM/
